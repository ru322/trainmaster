    patterns: {
        "fan": (rows: ["C-5 lead v15", "E-5 .. ...", "G-5 .. ...", "C-6 .. ... V24", "... .. ...", "=== .. ..."]),
        "hit": (rows: ["... .. ...", "... .. ...", "... .. ...", "N-1 crash v15", "... .. ...", "... .. ..."]),
