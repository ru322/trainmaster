SoundDef(
    format: 1,
    timing: Bpm(bpm: 150, rows_per_beat: 2),
    master: 110,
    imports: ["_lib/common.ron"],
    instruments: {
        "crash": (wave: Noise(mode: Long), env: (attack_ms: 0, decay_ms: 300, sustain: 0, release_ms: 0), volume: 60),
