// 路線をのばした。短い汽笛「ポッ」(se_line_new と同じ 3 声)。
SoundDef(
    format: 1,
    timing: RowMs(50),
    master: 47,
    imports: [],
    instruments: {
        "whistle": (wave: Pulse(duty: D25), env: (attack_ms: 10, decay_ms: 60, sustain: 80, release_ms: 40), volume: 100),
        "whistle_hi": (wave: Pulse(duty: D25), env: (attack_ms: 10, decay_ms: 60, sustain: 80, release_ms: 40), volume: 100, slide: Some((cents_per_sec: 802, ms: 10))),
    },
    channels: [
        (name: "p1", volume: 15, tonal: true),
        (name: "p2", volume: 15, tonal: true),
        (name: "p3", volume: 15, tonal: true),
    ],
    patterns: {
        "c0": (rows: [
            "F#5 whistle v15",
            "... .. ...",
            "... .. ...",
            "=== .. ...",
        ]),
        "c1": (rows: [
            "A-5 whistle v15",
            "... .. ...",
            "... .. ...",
            "=== .. ...",
        ]),
        "c2": (rows: [
            "A-5 whistle_hi v15",
            "... .. ...",
            "... .. ...",
            "=== .. ...",
        ]),
