// メニューを閉じた。三角波で E5 → C5 → G4。
SoundDef(
    format: 1,
    timing: RowMs(40),
    master: 190,
    imports: [],
    instruments: {
        "menu": (wave: Triangle, env: (attack_ms: 0, decay_ms: 40, sustain: 60, release_ms: 40), volume: 100),
